{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/post-bundle-1.json",
  "title": "t3cp/post-bundle/1: everything a release post may say, built by site/build/release-bundle.mjs and read by news/check.mjs",
  "description": "Built from t3cp/release-bundle/1 (site/build/aggregate.mjs releaseBundle()), the catalogue and the public changelog. Rows carry their display strings under text; value holds the same numbers for the release file and is never quoted. Not published: the release file carries its sha256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "bundle_sha256", "pending", "title", "platforms", "levels", "headline_level", "changelog", "metrics", "counts", "charts", "claims", "allowed_numbers", "allowed_literals", "allowed_metric_names", "catalogue_names", "verdict_words"],
  "properties": {
    "schema": { "const": "t3cp/post-bundle/1" },
    "synthetic": { "const": true },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "short", "date", "sha", "base", "prev"],
      "properties": {
        "tag": { "type": "string", "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-perf\\.\\d{1,3}$" },
        "short": { "type": "string", "pattern": "^perf\\.\\d{1,3}$" },
        "date": { "$ref": "#/$defs/date" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "base": { "$ref": "#/$defs/side" },
        "prev": { "$ref": "#/$defs/side" }
      }
    },
    "bundle_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The records digest tick dispatches with: sha256 over the sorted lines '<public path> <sha256 of the record bytes>' of the fork, base and previous records. A post names it; all zeros when a record is missing (pending)." },
    "pending": { "type": "boolean", "description": "No comparison: no post is written; the release renders tag, date, changelog and charts with no claims. pending_reason says why." },
    "pending_reason": { "type": ["string", "null"], "enum": ["records", "no_base", null], "description": "records: a fork, base or previous record is not complete yet. no_base: the base was measured in another era of the benchmark, and no verdict crosses an era boundary. null when the bundle is not pending." },
    "title": { "type": "string", "minLength": 1, "maxLength": 120, "description": "The release title, always the template: <tag>: <a> regressed, <b> improved, <c> within noise (vs <base tag>)." },
    "platforms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/platform_id" } },
    "levels": { "type": "array", "minItems": 1, "items": { "type": "string", "enum": ["1", "50", "100", "250"] } },
    "headline_level": { "type": "string", "enum": ["1", "50", "100", "250"] },
    "changelog": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "unit", "better", "headline", "platform", "level", "verdict", "note", "verdict_vs_prev", "note_vs_prev", "thin_reference", "saturated", "text", "value"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "name": { "type": "string", "maxLength": 120 },
          "unit": { "type": "string", "maxLength": 20 },
          "better": { "type": "string", "enum": ["lower", "higher"] },
          "headline": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
          "platform": { "$ref": "#/$defs/platform_id" },
          "level": { "type": "string", "enum": ["1", "50", "100", "250", "once"] },
          "verdict": { "$ref": "#/$defs/verdict" },
          "note": { "$ref": "#/$defs/note" },
          "verdict_vs_prev": { "$ref": "#/$defs/verdict" },
          "note_vs_prev": { "$ref": "#/$defs/note" },
          "thin_reference": { "type": "boolean" },
          "saturated": { "$ref": "#/$defs/saturated" },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fork", "base", "prev", "delta_pct", "band_pct", "threshold_pct", "delta_vs_prev_pct"],
            "properties": {
              "fork": { "$ref": "#/$defs/display" },
              "base": { "$ref": "#/$defs/display" },
              "prev": { "$ref": "#/$defs/display" },
              "delta_pct": { "$ref": "#/$defs/display" },
              "band_pct": { "$ref": "#/$defs/display" },
              "threshold_pct": { "$ref": "#/$defs/display" },
              "delta_vs_prev_pct": { "$ref": "#/$defs/display" }
            }
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fork", "base", "prev", "delta_pct", "threshold_pct", "delta_vs_prev_pct"],
            "properties": {
              "fork": { "type": ["number", "null"] },
              "base": { "type": ["number", "null"] },
              "prev": { "type": ["number", "null"] },
              "delta_pct": { "type": ["number", "null"] },
              "threshold_pct": { "type": ["number", "null"] },
              "delta_vs_prev_pct": { "type": ["number", "null"] }
            }
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "1": { "$ref": "#/$defs/count" }, "50": { "$ref": "#/$defs/count" }, "100": { "$ref": "#/$defs/count" }, "250": { "$ref": "#/$defs/count" } }
    },
    "charts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "platform", "kind", "comparison", "size", "headline", "caption"],
        "properties": {
          "id": { "type": "string", "maxLength": 120 },
          "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "platform": { "$ref": "#/$defs/platform_id" },
          "kind": { "type": "string", "enum": ["ladder", "series", "prev"] },
          "comparison": { "type": "string", "enum": ["base", "prev"] },
          "size": { "type": "number", "minimum": 0, "description": "Largest |change| / threshold over the levels; sections run largest first." },
          "headline": { "type": ["integer", "null"], "minimum": 1, "maximum": 8 },
          "caption": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      }
    },
    "claims": {
      "type": "array",
      "description": "Every claim a post may cite as {claim:<id>}: one row and comparison with a verdict, and the clause it renders to.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "platform", "level", "comparison", "verdict", "size", "clause"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}\\.(linux-x64|darwin-arm64)\\.(1|50|100|250|once)\\.(base|prev)$" },
          "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" },
          "platform": { "$ref": "#/$defs/platform_id" },
          "level": { "type": "string", "enum": ["1", "50", "100", "250", "once"] },
          "comparison": { "type": "string", "enum": ["base", "prev"] },
          "verdict": { "type": "string", "enum": ["regressed", "improved", "within"] },
          "size": { "type": "number", "minimum": 0, "description": "|change| / threshold for this row and comparison: the summary runs largest first." },
          "clause": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "allowed_numbers": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 32 } },
    "allowed_literals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 64 } },
    "allowed_metric_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 120 } },
    "catalogue_names": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "name"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$" }, "name": { "type": "string", "maxLength": 120 } }
      }
    },
    "verdict_words": {
      "type": "object",
      "additionalProperties": false,
      "required": ["improved", "regressed", "within", "time"],
      "properties": {
        "improved": { "$ref": "#/$defs/words" },
        "regressed": { "$ref": "#/$defs/words" },
        "within": { "$ref": "#/$defs/words" },
        "time": {
          "type": "object", "additionalProperties": false, "required": ["improved", "regressed"],
          "description": "Added for lower-is-better metrics measured in ms or s.",
          "properties": { "improved": { "type": "string" }, "regressed": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$" },
    "tag": { "type": "string", "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-nightly\\.20\\d{6}\\.\\d{1,6}|-perf\\.\\d{1,3})?$" },
    "side": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["tag", "date"],
      "properties": {
        "tag": { "type": ["string", "null"], "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-nightly\\.20\\d{6}\\.\\d{1,6}|-perf\\.\\d{1,3})?$" },
        "short": { "type": "string", "pattern": "^perf\\.\\d{1,3}$" },
        "date": { "$ref": "#/$defs/date" },
        "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$", "description": "The base: the upstream tree at this merge-base SHA (its nightly tag is context only); null before its record exists." }
      }
    },
    "platform_id": { "type": "string", "enum": ["linux-x64", "darwin-arm64"] },
    "verdict": { "type": ["string", "null"], "enum": ["regressed", "improved", "within", null] },
    "note": { "type": ["string", "null"], "enum": ["context", "no_band", "wide_band", "hollow", "gated", "no_reference", "no_data", "not_comparable", "no_base", "saturated", "zero_reference", null] },
    "saturated": {
      "type": "object", "additionalProperties": false, "required": ["fork", "base", "prev"],
      "description": "Whether each record's cell at this level is saturated (could not serve every agent). At a saturated level only turns_completed and agents_served keep a comparison; every other metric there has no verdict and note saturated.",
      "properties": { "fork": { "type": "boolean" }, "base": { "type": ["boolean", "null"] }, "prev": { "type": ["boolean", "null"] } }
    },
    "display": { "type": ["string", "null"], "maxLength": 32 },
    "count": {
      "type": "object", "additionalProperties": false, "required": ["improved", "regressed", "within", "no_verdict", "total"],
      "properties": {
        "improved": { "type": "integer", "minimum": 0 }, "regressed": { "type": "integer", "minimum": 0 },
        "within": { "type": "integer", "minimum": 0 }, "no_verdict": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "words": {
      "type": "object", "additionalProperties": false, "required": ["lower", "higher"],
      "properties": {
        "lower": { "type": "array", "items": { "type": "string" } },
        "higher": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
