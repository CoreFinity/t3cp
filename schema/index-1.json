    "platforms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "host",
          "live",
          "latest",
          "latest_date",
          "latest_tag",
          "latest_status",
          "records"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/platform_id"
          },
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "host": {
            "type": "string",
            "maxLength": 60
          },
          "live": {
            "type": "boolean"
          },
          "latest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^20\\d{2}-\\d{2}-\\d{2}\\.(linux-x64|darwin-arm64)\\.nightly$"
          },
          "latest_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "latest_tag": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-nightly\\.20\\d{6}\\.\\d{1,6}$"
          },
          "latest_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "complete",
              "partial",
              "missing",
              null
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "eras": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture",
        "feature",
        "harness"
      ],
      "properties": {
        "fixture": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "to",
              "migration"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^large-\\d{2,3}$"
              },
              "from": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
              },
              "migration": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              }
            }
          }
        },
        "feature": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "from",
              "what"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z_]+$"
              },
              "from": {
                "$ref": "#/$defs/date"
              },
              "what": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        },
        "harness": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "files_sha256",
              "from",
              "to"
            ],
            "properties": {
              "version": {
                "type": "string",
                "pattern": "^t3cp-harness/\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
              },
              "files_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "from": {
                "$ref": "#/$defs/date"
              },
              "to": {
                "$ref": "#/$defs/date"
              }
            }
          }
        }
      }
    },
