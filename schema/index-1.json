          }
        }
      }
    },
    "records_index": {
      "const": "records-index.json",
      "description": "The file that lists every nightly record (t3cp/records-index/1); it is never part of the overview payload."
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overview_gz_bytes",
        "overview_limit_gz_bytes"
      ],
      "properties": {
        "overview_gz_bytes": {
          "type": "object",
          "additionalProperties": false,
          "description": "Per platform with records, the overview payload as built (index.json, changes.json and the eight headline latest shards), in gzipped bytes; it counts this file too, so it may exceed its own size by a few bytes, never fall below it.",
          "properties": {
            "linux-x64": {
              "type": "integer",
              "minimum": 0
            },
            "darwin-arm64": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "overview_limit_gz_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fork": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "date",
          "sha",
          "base_tag",
          "base_date",
          "prev_tag",
          "base_sha",
          "base_record",
          "platforms"
        ],
        "properties": {
          "tag": {
            "$ref": "#/$defs/fork_tag"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "sha": {
            "$ref": "#/$defs/sha"
          },
          "base_tag": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-nightly\\.20\\d{6}\\.\\d{1,6}$"
          },
          "base_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "prev_tag": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-perf\\.\\d{1,3}$"
          },
          "base_sha": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40}$"
          },
          "base_record": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^base/[0-9a-f]{12}\\.(linux-x64|darwin-arm64)\\.json$"
          },
          "platforms": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "linux-x64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "status",
                  "path"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "#/$defs/record_id"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "complete",
                      "partial",
                      "missing"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(records/(linux-x64|darwin-arm64)/[A-Za-z0-9.-]+|fork/[A-Za-z0-9.-]+|base/[A-Za-z0-9.-]+)\\.json$"
                  }
                }
              },
              "darwin-arm64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "status",
                  "path"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "#/$defs/record_id"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "complete",
                      "partial",
                      "missing"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(records/(linux-x64|darwin-arm64)/[A-Za-z0-9.-]+|fork/[A-Za-z0-9.-]+|base/[A-Za-z0-9.-]+)\\.json$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "bases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "date",
          "tag",
          "platforms"
        ],
        "properties": {
          "sha": {
            "$ref": "#/$defs/sha"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "platforms": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "linux-x64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "status",
                  "path"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "#/$defs/record_id"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "complete",
                      "partial",
                      "missing"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(records/(linux-x64|darwin-arm64)/[A-Za-z0-9.-]+|fork/[A-Za-z0-9.-]+|base/[A-Za-z0-9.-]+)\\.json$"
                  }
                }
              },
              "darwin-arm64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "record_id",
                  "status",
                  "path"
                ],
                "properties": {
                  "record_id": {
                    "$ref": "#/$defs/record_id"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "complete",
                      "partial",
                      "missing"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^(records/(linux-x64|darwin-arm64)/[A-Za-z0-9.-]+|fork/[A-Za-z0-9.-]+|base/[A-Za-z0-9.-]+)\\.json$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux-x64": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/metric_id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(all|latest|20\\d{2})$"
            }
          }
        },
        "darwin-arm64": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/metric_id"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(all|latest|20\\d{2})$"
            }
          }
        }
      }
    },
    "compare": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^compare/[A-Za-z0-9.-]+__[A-Za-z0-9.-]+\\.(linux-x64|darwin-arm64)\\.json$"
      }
    },
    "downloads": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^downloads/[a-z0-9.-]+$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
