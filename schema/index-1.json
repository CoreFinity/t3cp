          "cap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "linux-x64",
              "darwin-arm64"
            ],
            "description": "Per platform and per level the metric has, the aggregator's capability: the threshold a comparison uses and the note that stops every verdict there (context, no_band, wide_band), a level's own band overriding the metric's. A counter needs no band: threshold and note are null. A pair also loses its band when either record is not banded (records-index.json): then a non-counter has threshold null and note no_band, unless a note here applies. These rule inputs serve the compare page's nightly pairs; a fork release's verdicts come through the aggregator's own compare files.",
            "properties": {
              "linux-x64": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "1": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "threshold",
                      "note"
                    ],
                    "properties": {
                      "threshold": {
                        "type": [
                          "number",
                          "null"
                        ],
                        "description": "The verdict threshold in percent (the band plus 5 points); null where the metric has none."
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "enum": [
                          "context",
                          "no_band",
                          "wide_band",
                          null
                        ],
                        "description": "Why no comparison at this level has a verdict, whatever the pair; null when one can."
                      }
                    }
                  },
