{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/index-1.json",
  "title": "t3cp/index/1: the site's manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "schemas",
    "levels",
    "empty_cell",
    "headline_levels",
    "default_headline_level",
    "groups",
    "headlines",
    "catalogue",
    "platforms",
    "eras",
    "fixtures",
    "records_index",
    "budgets",
    "fork",
    "bases",
    "series",
    "compare",
    "downloads"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/index/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "schemas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record",
        "series",
        "bands",
        "changes",
        "compare"
      ],
      "properties": {
        "record": {
          "const": "t3cp/record/1"
        },
        "series": {
          "const": "t3cp/series/1"
        },
        "bands": {
          "const": "t3cp/bands/1"
        },
        "changes": {
          "const": "t3cp/changes/1"
        },
        "compare": {
          "const": "t3cp/compare/1"
        }
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "empty_cell": {
      "const": "1e"
    },
    "headline_levels": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "default_headline_level": {
      "type": "integer"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+$"
          },
          "name": {
            "type": "string",
            "maxLength": 60
