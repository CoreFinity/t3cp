{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/scenario-series-1.json",
  "title": "t3cp/scenario-series/1: one metric of one scenarios.json row on one platform, per cell, over its records",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "suite",
    "scenario",
    "platform",
    "metric",
    "unit",
    "nightly",
    "fork",
    "base",
    "eras"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/scenario-series/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "suite": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*@[1-9][0-9]{0,5}$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 41
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        }
      }
    },
    "platform": {
      "$ref": "#/$defs/platform_id"
    },
    "metric": {
      "type": "string",
      "enum": [
        "turn_start_history_gap_ms",
        "turn_start_long_thread_ms",
        "get_thread_shell_long_thread_ms",
        "event_log_unpruned_days"
      ]
    },
    "unit": {
      "type": "string"
    },
    "nightly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dates",
        "tags",
        "cells"
      ],
      "properties": {
        "dates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/date"
          },
          "maxItems": 400
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tag"
          },
          "maxItems": 400
        },
        "cells": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "median",
              "min",
              "max",
              "n",
              "reason",
              "segment"
            ],
            "properties": {
              "median": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxItems": 400
              },
              "min": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxItems": 400
              },
              "max": {
                "type": "array",
                "items": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "maxItems": 400
              },
              "n": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "maxItems": 400
              },
              "reason": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "no_turn_start_span",
                    "turn_start_incomplete",
                    "no_shell_span",
                    "shell_reads_missing",
                    "no_event_prune",
                    null
                  ]
                },
                "maxItems": 400
              },
              "segment": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 281474976710655
                },
                "maxItems": 400
              }
            }
          }
        }
      }
    },
    "fork": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "date",
          "base_tag",
          "base_date",
          "cells"
        ],
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "base_tag": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_date": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
          },
          "cells": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "median",
                "min",
                "max",
                "n",
                "reason",
                "segment"
              ],
              "properties": {
                "median": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "n": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "no_turn_start_span",
                    "turn_start_incomplete",
                    "no_shell_span",
                    "shell_reads_missing",
                    "no_event_prune",
                    null
                  ]
                },
                "segment": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 281474976710655,
                  "description": "An opaque id of the value's segment (fixture, row, harness tree, cell load): values compare only within one."
                }
              }
            }
          }
        }
      },
      "maxItems": 200
    },
    "base": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tag",
          "sha",
          "date",
          "cells"
        ],
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "sha": {
            "$ref": "#/$defs/sha"
          },
          "date": {
            "$ref": "#/$defs/date"
          },
          "cells": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,30}$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "median",
                "min",
                "max",
                "n",
                "reason",
                "segment"
              ],
              "properties": {
                "median": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "min": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "max": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "n": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 5
                },
                "reason": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "no_turn_start_span",
                    "turn_start_incomplete",
                    "no_shell_span",
                    "shell_reads_missing",
                    "no_event_prune",
                    null
                  ]
                },
                "segment": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 281474976710655,
                  "description": "An opaque id of the value's segment (fixture, row, harness tree, cell load): values compare only within one."
                }
              }
            }
          }
        }
      },
      "maxItems": 200
    },
    "eras": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "label"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "kind": {
            "type": "string",
            "enum": [
              "harness",
              "fixture",
              "metric"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "maxItems": 100
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "platform_id": {
      "type": "string",
      "enum": [
        "linux-x64",
        "darwin-arm64"
      ]
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-nightly\\.20\\d{6}\\.\\d{1,6}|-perf\\.\\d{1,3})?$"
    }
  }
}
