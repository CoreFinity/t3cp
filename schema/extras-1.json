{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/extras-1.json",
  "title": "t3cp/extras/1: the exporter's output for one record's extras (startup, migrations, snapshot, first turn)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "record_id",
    "fixture",
    "empty",
    "migration",
    "pipeline"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/extras/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "record_id": {
      "$ref": "#/$defs/record_id"
    },
    "fixture": {
      "$ref": "#/$defs/extras_part"
    },
    "empty": {
      "$ref": "#/$defs/extras_part"
    },
    "migration": {
      "$ref": "#/$defs/migration"
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exported_at",
        "exporter_version",
        "exporter_files_sha256",
        "runner_version",
        "runner_files_sha256"
      ],
      "properties": {
        "exported_at": {
          "$ref": "#/$defs/datetime"
        },
        "exporter_version": {
          "type": "string",
          "pattern": "^\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
        },
        "exporter_files_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "runner_version": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^t3cp-runner/\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}$"
        },
        "runner_files_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "$defs": {
    "datetime": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "extras_part": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "metrics"
      ],
      "properties": {
        "metrics": {
          "$ref": "#/$defs/record_stats"
        }
      }
    },
    "migration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "per_migration"
      ],
      "properties": {
        "per_migration": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "s"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9999
              },
              "s": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "maxItems": 200
        }
      }
    },
    "record_id": {
      "type": "string",
      "pattern": "^(20\\d{2}-\\d{2}-\\d{2}\\.(linux-x64|darwin-arm64)\\.nightly|\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-perf\\.\\d{1,3}\\.(linux-x64|darwin-arm64)\\.fork|[0-9a-f]{12}\\.(linux-x64|darwin-arm64)\\.base)$"
    },
    "record_stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpu_per_session_pct": {
          "$ref": "#/$defs/stat_num_neg100000_100000"
        },
        "listening_first_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "listening_warm_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "accept_first_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "accept_warm_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "db_ready_first_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "db_ready_warm_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "first_boot_migrations_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "migration_s": {
          "$ref": "#/$defs/stat_num_0_1000000"
        },
        "migration_extra_disk_mib": {
          "$ref": "#/$defs/stat_num_0_10000000"
        },
        "snapshot_full_get_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        },
        "snapshot_full_get_bytes": {
          "$ref": "#/$defs/stat_int_0_10000000000000"
        },
        "first_turn_after_start_ms": {
          "$ref": "#/$defs/stat_num_0_100000000"
        }
      }
    },
    "stat_int_0_10000000000000": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "median",
        "min",
        "max",
        "n",
        "values"
      ],
      "properties": {
        "median": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000000000
        },
        "min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000000000
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 10000000000000
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "values": {
          "type": "array",
          "items": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 10000000000000
          },
          "maxItems": 9
        },
        "reason": {
          "type": "string",
          "enum": [
            "fewer_than_two_served_levels",
            "not_measured_saturated",
            "extra_timeout",
            "no_setup_span"
          ]
        }
      }
    },
