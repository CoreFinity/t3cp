{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/changes-1.json",
  "title": "t3cp/changes/1: the changes feed, the last 90 days of verdicts where the 7-day and day-over-day verdicts agree",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "window_days",
    "from",
    "to",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/changes/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    },
    "from": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "to": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "platform",
          "level",
          "metric",
          "tag",
          "verdict",
          "value",
          "reference",
          "delta",
          "band",
          "threshold",
          "thin",
          "dod_delta"
        ],
        "properties": {
          "date": {
            "$ref": "#/$defs/date"
          },
          "platform": {
            "$ref": "#/$defs/platform_id"
          },
          "level": {
            "$ref": "#/$defs/series_level"
          },
          "metric": {
            "$ref": "#/$defs/metric_id"
          },
          "tag": {
            "$ref": "#/$defs/nightly_tag"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "regressed",
              "improved"
            ]
          },
          "value": {
            "type": "number"
          },
          "reference": {
            "type": [
              "number",
              "null"
            ]
          },
          "delta": {
            "type": [
              "number",
              "null"
            ]
          },
          "band": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold": {
            "type": [
              "number",
              "null"
            ]
          },
          "thin": {
            "type": "boolean"
          },
          "dod_delta": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "datetime": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "metric_id": {
      "type": "string",
      "enum": [
        "turns_completed",
        "agents_served",
        "turn_p50_ms",
        "turn_p95_ms",
        "dispatch_p50_ms",
        "dispatch_p95_ms",
        "first_item_p50_ms",
        "push_p95_ms",
        "switch_open_p50_ms",
        "switch_sync_p95_ms",
        "shell_sync_p95_ms",
        "poll_thread_read_p95_ms",
        "poll_project_list_p95_ms",
        "poll_http_bounded_p95_ms",
        "session_mcp_p95_ms",
        "thread_events_per_s",
        "shell_events_per_s",
        "client_errors",
        "client_unfinished",
        "main_busy_pct",
        "main_user_pct",
        "main_sys_pct",
        "proc_cpu_pct",
        "workers_cpu_pct",
        "children_cpu_pct",
        "children_n",
        "elu",
        "elu_max",
        "eld_p50_ms",
        "eld_p99_ms",
        "eld_max_ms",
        "server_eld_max_ms",
        "gc_ms_per_s",
        "stall_share_40ms",
        "stall_share_100ms",
        "stall_share_500ms",
        "main_busy_1s_p95",
        "main_runq_wait_ms_per_s",
        "main_minflt_per_s",
        "main_vcs_per_s",
        "main_nvcs_per_s",
        "main_syscr_per_s",
        "main_syscw_per_s",
        "proc_syscr_per_s",
        "cpu_per_session_pct",
        "rss_peak_mib",
        "heap_peak_mib",
        "heap_floor_mib",
        "pss_total_mib",
        "uss_total_mib",
        "rss_slope_mib_per_h",
        "heap_slope_mib_per_h",
        "wal_max_mib",
        "wal_median_mib",
        "reader_tx_avg_ms",
        "reader_tx_p95_ms",
        "reader_tx_wait_avg_ms",
        "reader_tx_wait_p95_ms",
        "reader_stmt_p95_ms",
        "writer_tx_avg_ms",
        "writer_tx_p95_ms",
        "writer_tx_wait_p95_ms",
        "reader_tx_per_s",
        "writer_tx_per_s",
        "reader_pool_occupancy",
        "reader_free_while_waiting_s",
        "sql_time_ms_per_s",
        "get_thread_shell_p95_ms",
        "snapshot_window_p95_ms",
        "mcp_auth_p95_ms",
        "turn_start_p50_ms",
        "handle_run_update_p95_ms",
        "finalize_subagent_p50_ms",
        "effect_queue_wait_p50_ms",
        "effect_queue_wait_p90_ms",
        "events_per_commit",
        "spans_in_window",
        "trace_dropped",
        "git_commands_per_turn",
        "git_ms_per_turn",
        "forks_per_turn",
        "ps_gap_ms_per_h",
        "listening_first_ms",
        "listening_warm_ms",
        "accept_first_ms",
        "accept_warm_ms",
        "db_ready_first_ms",
        "db_ready_warm_ms",
        "first_boot_migrations_ms",
        "migration_s",
        "migration_extra_disk_mib",
        "shutdown_s",
        "compaction_probe_max_ms",
        "compaction_pages_per_min",
        "snapshot_full_get_ms",
        "snapshot_full_get_bytes",
        "idle_cpu_pct",
        "idle_wakeups_per_s",
        "idle_pss_30min_mib",
        "first_turn_after_start_ms",
        "queue_start_p50_s",
        "queue_start_p90_s",
        "queue_start_max_s",
        "consumer_backlog_max",
        "consumer_drain_s",
        "delivery_by_state_p50_s",
        "buffer_full_warnings",
        "server_warn_lines",
        "server_error_lines",
        "stream_resyncs",
        "attempts_valid",
        "attempts_total",
        "host_busy_pct",
        "host_steal_pct",
        "host_iowait_pct",
        "contaminated",
        "fork_effect_queue_wait_p95_ms",
        "fork_run_effect_p95_ms",
        "fork_decode_projection_p95_ms",
        "fork_admission_changes",
        "turn_start_history_gap_ms",
        "turn_start_long_thread_ms",
        "get_thread_shell_long_thread_ms",
        "event_log_unpruned_days"
      ]
    },
    "nightly_tag": {
      "type": "string",
      "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-nightly\\.20\\d{6}\\.\\d{1,6}$"
    },
    "platform_id": {
      "type": "string",
      "enum": [
        "linux-x64",
        "darwin-arm64"
      ]
    },
    "series_level": {
      "type": "string",
      "enum": [
        "1",
        "50",
        "100",
        "150",
        "200",
        "250",
        "1e",
        "once"
      ]
    }
  }
}
