{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/release-bundle-1.json",
  "title": "t3cp/release-bundle/1: the numbers for one fork release's post, from site/build/aggregate.mjs releaseBundle()",
  "description": "delta_pct = (fork - base) / base in percent with its real sign; worse_pct is the same change sign-adjusted so positive means worse (the value the verdict rule compares with the threshold). text holds the display strings the prose may copy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release",
    "base",
    "prev",
    "platforms",
    "levels",
    "counts",
    "metrics",
    "allowed_numbers",
    "allowed_metric_names"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/release-bundle/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tag",
        "date",
        "sha"
      ],
      "properties": {
        "tag": {
          "$ref": "#/$defs/fork_tag"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "sha": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "base": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "tag",
        "date"
      ],
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-nightly\\.20\\d{6}\\.\\d{1,6}|-perf\\.\\d{1,3})?$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "prev": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "tag",
        "date"
      ],
      "properties": {
        "tag": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}(-nightly\\.20\\d{6}\\.\\d{1,6}|-perf\\.\\d{1,3})?$"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/platform_id"
      }
    },
    "levels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/series_level"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regressed",
        "improved",
        "within",
        "no_verdict"
      ],
      "properties": {
        "regressed": {
          "type": "integer",
          "minimum": 0
        },
        "improved": {
          "type": "integer",
          "minimum": 0
        },
        "within": {
          "type": "integer",
          "minimum": 0
        },
        "no_verdict": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "unit",
          "better",
          "headline",
          "platform",
          "level",
          "fork",
          "base",
          "prev",
          "band_pct",
          "threshold_pct",
          "delta_pct",
          "worse_pct",
          "verdict",
          "note",
          "delta_vs_prev_pct",
          "worse_vs_prev_pct",
          "verdict_vs_prev",
          "note_vs_prev",
          "saturated",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/metric_id"
          },
          "name": {
            "type": "string",
            "maxLength": 120
          },
          "unit": {
            "type": "string",
            "maxLength": 20
          },
          "better": {
            "type": "string",
            "enum": [
              "lower",
              "higher",
              "context"
            ]
          },
          "headline": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 8
          },
          "platform": {
            "$ref": "#/$defs/platform_id"
          },
          "level": {
            "$ref": "#/$defs/series_level"
          },
          "fork": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "median",
              "min",
              "max",
              "n"
            ],
            "properties": {
              "median": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              }
            }
          },
          "base": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "median",
              "min",
              "max",
              "n"
            ],
            "properties": {
              "median": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              }
            }
          },
          "prev": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "median",
              "min",
              "max",
              "n"
            ],
            "properties": {
              "median": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "n": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9
              }
            }
          },
          "band_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "threshold_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "delta_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "worse_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "verdict": {
            "$ref": "#/$defs/verdict"
          },
          "note": {
            "$ref": "#/$defs/note"
          },
          "delta_vs_prev_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "worse_vs_prev_pct": {
            "type": [
              "number",
              "null"
            ]
          },
          "verdict_vs_prev": {
            "$ref": "#/$defs/verdict"
          },
          "note_vs_prev": {
            "$ref": "#/$defs/note"
          },
          "saturated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fork",
              "base",
              "prev"
            ],
            "properties": {
              "fork": {
                "type": "boolean"
              },
              "base": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "prev": {
                "type": [
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fork",
              "base",
              "prev",
              "delta_pct",
              "band_pct",
              "threshold_pct",
              "delta_vs_prev_pct"
            ],
            "properties": {
              "fork": {
                "type": "string"
              },
              "base": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "prev": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "delta_pct": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "band_pct": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "threshold_pct": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "delta_vs_prev_pct": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "allowed_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "allowed_metric_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    },
    "fork_tag": {
      "type": "string",
      "pattern": "^v\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-perf\\.\\d{1,3}$"
    },
    "metric_id": {
      "type": "string",
      "enum": [
        "turns_completed",
        "agents_served",
        "turn_p50_ms",
        "turn_p95_ms",
        "dispatch_p50_ms",
        "dispatch_p95_ms",
        "first_item_p50_ms",
        "push_p95_ms",
        "switch_open_p50_ms",
        "switch_sync_p95_ms",
        "shell_sync_p95_ms",
        "poll_thread_read_p95_ms",
        "poll_project_list_p95_ms",
        "poll_http_bounded_p95_ms",
        "session_mcp_p95_ms",
        "thread_events_per_s",
        "shell_events_per_s",
        "client_errors",
        "client_unfinished",
        "main_busy_pct",
        "main_user_pct",
        "main_sys_pct",
        "proc_cpu_pct",
        "workers_cpu_pct",
        "children_cpu_pct",
        "children_n",
        "elu",
        "elu_max",
        "eld_p50_ms",
        "eld_p99_ms",
        "eld_max_ms",
        "server_eld_max_ms",
        "gc_ms_per_s",
        "stall_share_40ms",
        "stall_share_100ms",
        "stall_share_500ms",
        "main_busy_1s_p95",
        "main_runq_wait_ms_per_s",
        "main_minflt_per_s",
        "main_vcs_per_s",
        "main_nvcs_per_s",
        "main_syscr_per_s",
        "main_syscw_per_s",
        "proc_syscr_per_s",
        "cpu_per_session_pct",
        "rss_peak_mib",
        "heap_peak_mib",
        "heap_floor_mib",
        "pss_total_mib",
        "uss_total_mib",
        "rss_slope_mib_per_h",
        "heap_slope_mib_per_h",
        "wal_max_mib",
        "wal_median_mib",
        "reader_tx_avg_ms",
        "reader_tx_p95_ms",
        "reader_tx_wait_avg_ms",
        "reader_tx_wait_p95_ms",
        "reader_stmt_p95_ms",
        "writer_tx_avg_ms",
        "writer_tx_p95_ms",
        "writer_tx_wait_p95_ms",
        "reader_tx_per_s",
        "writer_tx_per_s",
        "reader_pool_occupancy",
        "reader_free_while_waiting_s",
        "sql_time_ms_per_s",
        "get_thread_shell_p95_ms",
        "snapshot_window_p95_ms",
        "mcp_auth_p95_ms",
        "turn_start_p50_ms",
        "handle_run_update_p95_ms",
        "finalize_subagent_p50_ms",
        "effect_queue_wait_p50_ms",
        "effect_queue_wait_p90_ms",
        "events_per_commit",
        "spans_in_window",
        "trace_dropped",
        "git_commands_per_turn",
        "git_ms_per_turn",
        "forks_per_turn",
        "ps_gap_ms_per_h",
        "listening_first_ms",
        "listening_warm_ms",
        "accept_first_ms",
        "accept_warm_ms",
        "db_ready_first_ms",
        "db_ready_warm_ms",
        "first_boot_migrations_ms",
        "migration_s",
        "migration_extra_disk_mib",
        "shutdown_s",
        "compaction_probe_max_ms",
        "compaction_pages_per_min",
        "snapshot_full_get_ms",
        "snapshot_full_get_bytes",
        "idle_cpu_pct",
        "idle_wakeups_per_s",
        "idle_pss_30min_mib",
        "first_turn_after_start_ms",
        "queue_start_p50_s",
        "queue_start_p90_s",
        "queue_start_max_s",
        "consumer_backlog_max",
        "consumer_drain_s",
        "delivery_by_state_p50_s",
        "buffer_full_warnings",
        "server_warn_lines",
        "server_error_lines",
        "stream_resyncs",
        "attempts_valid",
        "attempts_total",
        "host_busy_pct",
        "host_steal_pct",
        "host_iowait_pct",
        "contaminated",
        "fork_effect_queue_wait_p95_ms",
        "fork_run_effect_p95_ms",
        "fork_decode_projection_p95_ms",
        "fork_admission_changes",
        "turn_start_history_gap_ms",
        "turn_start_long_thread_ms",
        "get_thread_shell_long_thread_ms",
        "event_log_unpruned_days"
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "context",
        "no_band",
        "wide_band",
        "hollow",
        "gated",
        "no_reference",
        "no_data",
        "not_comparable",
        "no_base",
        "zero_reference",
        "saturated",
        null
      ]
    },
    "platform_id": {
      "type": "string",
      "enum": [
        "linux-x64",
        "darwin-arm64"
      ]
    },
    "series_level": {
      "type": "string",
      "enum": [
        "1",
        "50",
        "100",
        "150",
        "200",
        "250",
        "1e",
        "once"
      ]
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "regressed",
        "improved",
        "within",
        null
      ]
    }
  }
}
