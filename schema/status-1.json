{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://t3cp.io/schema/status-1.json",
  "title": "t3cp/status/1: the public pipeline state (data/v1/status.json, written by the ops tick): numbers, dates and reason codes only, no free text",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "platforms"
  ],
  "properties": {
    "schema": {
      "const": "t3cp/status/1"
    },
    "synthetic": {
      "const": true,
      "description": "Present only on development data from tools/t3cp/dev/synth-data.mjs; refused under data/."
    },
    "generated_at": {
      "$ref": "#/$defs/datetime"
    },
    "platforms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux-x64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latest_record_id",
            "latest_date",
            "latest_status",
            "queue",
            "last_failure",
            "heartbeat_at"
          ],
          "properties": {
            "latest_record_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-\\d{2}-\\d{2}\\.(linux-x64|darwin-arm64)\\.nightly$"
            },
            "latest_date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "latest_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "complete",
                "partial",
                "missing",
                null
              ]
            },
            "queue": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pending",
                "active"
              ],
              "properties": {
                "pending": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "active": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              }
            },
            "last_failure": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "record_id",
                "at",
                "reason"
              ],
              "properties": {
                "record_id": {
                  "$ref": "#/$defs/record_id"
                },
                "at": {
                  "$ref": "#/$defs/datetime"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "preempted",
                    "cpu_mismatch",
                    "archive_missing",
                    "export_failed",
                    "contaminated",
                    "runner_offline",
                    "timeout",
                    "attempts_invalid",
                    "migration_failed",
                    "build_failed"
                  ],
                  "description": "preempted: the cloud VM was reclaimed while the record ran; cpu_mismatch: the machine did not have the pinned CPU model; archive_missing: the release archive could not be fetched or verified; export_failed: an attempt's results could not be exported safely; contaminated: other load on the machine disturbed the measurement; runner_offline: the measurement infrastructure was unavailable; timeout: the record did not finish in time; attempts_invalid: too few attempts at a level were valid; migration_failed: the nightly could not migrate the fixture; build_failed: a fork release or base tree could not be built from source"
                }
              }
            },
            "heartbeat_at": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
            }
          }
        },
        "darwin-arm64": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latest_record_id",
            "latest_date",
            "latest_status",
            "queue",
            "last_failure",
            "heartbeat_at"
          ],
          "properties": {
            "latest_record_id": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-\\d{2}-\\d{2}\\.(linux-x64|darwin-arm64)\\.nightly$"
            },
            "latest_date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
            },
            "latest_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "complete",
                "partial",
                "missing",
                null
              ]
            },
            "queue": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pending",
                "active"
              ],
              "properties": {
                "pending": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                },
                "active": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 999
                }
              }
            },
            "last_failure": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "required": [
                "record_id",
                "at",
                "reason"
              ],
              "properties": {
                "record_id": {
                  "$ref": "#/$defs/record_id"
                },
                "at": {
                  "$ref": "#/$defs/datetime"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "preempted",
                    "cpu_mismatch",
                    "archive_missing",
                    "export_failed",
                    "contaminated",
                    "runner_offline",
                    "timeout",
                    "attempts_invalid",
                    "migration_failed",
                    "build_failed"
                  ],
                  "description": "preempted: the cloud VM was reclaimed while the record ran; cpu_mismatch: the machine did not have the pinned CPU model; archive_missing: the release archive could not be fetched or verified; export_failed: an attempt's results could not be exported safely; contaminated: other load on the machine disturbed the measurement; runner_offline: the measurement infrastructure was unavailable; timeout: the record did not finish in time; attempts_invalid: too few attempts at a level were valid; migration_failed: the nightly could not migrate the fixture; build_failed: a fork release or base tree could not be built from source"
                }
              }
            },
            "heartbeat_at": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "datetime": {
      "type": "string",
      "pattern": "^20\\d{2}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$"
    },
    "record_id": {
      "type": "string",
      "pattern": "^(20\\d{2}-\\d{2}-\\d{2}\\.(linux-x64|darwin-arm64)\\.(nightly|fork)|\\d{1,3}\\.\\d{1,3}\\.\\d{1,4}-perf\\.\\d{1,3}\\.(linux-x64|darwin-arm64)\\.fork|[0-9a-f]{12}\\.(linux-x64|darwin-arm64)\\.base)$",
      "description": "<date>.<platform>.nightly (a nightly); <version>.<platform>.fork (a fork release); <date>.<platform>.fork (the nightly fork-head record: the fork's latest release measured on that night, with paired_nightly); <first 12 hex of the merge-base SHA>.<platform>.base (a base record)."
    }
  }
}
