{
  "schema": "t3cp/audit-patterns/1",
  "description": "The generic public pattern list for audit-public-tree: shapes only, never a concrete name; the concrete names live in the private gate, which also runs over this repository. Sources are JavaScript regular expressions written so that they do not match themselves. An exception permits any match lying wholly inside its exact string, in its scope (files by default, or messages).",
  "patterns": [
    { "id": "host-ws-n", "source": "\\bws[0-9]\\b", "flags": "i", "target": "raw", "description": "A short host name of the form ws<digit>." },
    { "id": "host-dot-local", "source": "(?<![\\w.-])(?!env\\.)[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9-]+)*\\.local\\b(?!-)", "flags": "i", "target": "raw", "description": "A multicast-DNS host name (the dotenv local-file suffix is not one)." },
    { "id": "path-users", "source": "/U[s]ers/", "flags": "", "target": "raw", "description": "A macOS home directory path." },
    { "id": "path-home", "source": "/hom[e]/", "flags": "", "target": "raw", "description": "A Linux home directory path." },
    { "id": "path-mnt", "source": "/mn[t]/", "flags": "", "target": "raw", "description": "A mount path." },
    { "id": "path-volumes", "source": "/Volume[s]/", "flags": "", "target": "raw", "description": "A macOS volume path." },
    { "id": "path-tilde", "source": "~[/]", "flags": "", "target": "raw", "description": "A home-relative path." },
    { "id": "path-var", "source": "/va[r]/(?=[A-Za-z0-9._~-])", "flags": "", "target": "raw", "description": "An absolute /var path (web roots, service state)." },
    { "id": "path-tmp", "source": "(?<![A-Za-z0-9._~-])/tm[p]/(?=[A-Za-z0-9._~-])", "flags": "", "target": "raw", "description": "An absolute /tmp path on a machine." },
    { "id": "path-root", "source": "(?<![A-Za-z0-9._~-])/roo[t]/(?=[A-Za-z0-9._~-])", "flags": "", "target": "raw", "description": "An absolute /root path." },
    { "id": "cloud-region", "source": "\\b(?:us|europe|asia|me|africa|northamerica|southamerica|australia)-(?:central|east|west|north|south|northeast|northwest|southeast|southwest)-?[0-9]+(?:-[a-f])?\\b", "flags": "i", "target": "raw", "description": "A cloud region or zone shape." },
    { "id": "ipv4", "source": "(?<![0-9.])(?:[0-9]{1,3}\\.){3}[0-9]{1,3}(?![0-9]|\\.[0-9])", "flags": "", "target": "raw", "confirm": "reportable-ipv4", "description": "An IPv4 address other than loopback, the unspecified address, broadcast and the documentation ranges." },
    { "id": "ipv6", "source": "\\b(?:[0-9a-f]{1,4}:){3,7}[0-9a-f]{1,4}\\b", "flags": "i", "target": "raw", "description": "An IPv6 address in full or partly compressed form." },
    { "id": "ipv6-compressed", "source": "(?<![\\w:])(?:[0-9a-f]{1,4}:){1,7}:(?:[0-9a-f]{1,4}(?::[0-9a-f]{1,4}){0,6})?(?![\\w:])|(?<![\\w:])::(?:ffff:)?[0-9a-f]{1,4}(?:[:.][0-9a-f]{1,4}){1,6}(?![\\w:])", "flags": "i", "target": "raw", "confirm": "ipv6-not-tiny", "description": "A compressed IPv6 address (a double colon); the loopback and other tiny forms are not identifying." },
    { "id": "bucket-url", "source": "\\bg[s]://|\\bs[3]://", "flags": "", "target": "raw", "description": "A cloud bucket URL (the gs or s3 scheme)." },
    { "id": "vm-name", "source": "(?<![A-Za-z0-9-])t3cp-r-[a-z0-9][a-z0-9-]*", "flags": "i", "target": "raw", "description": "The name of one of the project's runner VMs (t3cp-r-*), also its host name." },
    { "id": "host-field", "source": "(?<![A-Za-z0-9_-])[\"']?(?:host|hostname|host_name|hostName)[\"']?\\s*[:=]\\s*([\"'])([^\"'\\n]*)\\1", "flags": "", "target": "raw", "confirm": "real-host", "description": "A host or hostname field with a quoted value that is not a placeholder (localhost, loopback, the example and test domains, <host>, a template, empty)." },
    { "id": "id-task", "source": "\\bP[12]-[0-9]+\\b", "flags": "", "target": "raw", "description": "A task id shape." },
    { "id": "id-workstream", "source": "\\bW[0-9]+-[0-9]+\\b", "flags": "", "target": "raw", "description": "A work-item id shape." },
    { "id": "id-decision", "source": "\\bA[0-9]{2,3}\\b", "flags": "", "target": "raw", "description": "A decision id shape." },
    { "id": "id-question", "source": "\\bQ[0-9]+\\b", "flags": "", "target": "raw", "description": "A question id shape." },
    { "id": "evidence-dir", "source": "\\bp[0-9]-[0-9]{3}-evidenc[e]\\b|\\bin[v]-[a-z]+", "flags": "", "target": "raw", "description": "An evidence directory name shape." },
    { "id": "node-options-value", "source": "--max-old-space-siz[e]|--requir[e][= ]\\S", "flags": "", "target": "raw", "description": "A NODE_OPTIONS value (a heap size or a preload path)." },
    { "id": "harness-ref-field", "source": "\\bserver_re[f]\\b", "flags": "", "target": "raw", "description": "The harness identity field that carries a machine path." },
    { "id": "email", "source": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@(?!(?:[A-Za-z0-9-]+\\.)*(?:example\\.(?:com|org|net)|[A-Za-z0-9-]+\\.(?:test|invalid|example|localhost))\\b)[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}\\b", "flags": "", "target": "raw", "description": "An email address (the reserved example and test domains are nobody's)." },
    { "id": "secret-private-key", "source": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY(?: BLOCK)?-----", "flags": "", "target": "decoded", "description": "A private key header." },
    { "id": "secret-private-key-body", "source": "^[ +-]?[A-Za-z0-9+/]{60,76}={0,2}$", "flags": "", "target": "decoded", "description": "A base64 key body line." },
    { "id": "secret-github-token", "source": "(?<![A-Za-z0-9])gh[pousr]_[A-Za-z0-9]{36,}", "flags": "", "target": "decoded", "description": "A GitHub token." },
    { "id": "secret-github-pat", "source": "(?<![A-Za-z0-9])github_pat_[A-Za-z0-9_]{22,}", "flags": "", "target": "decoded", "description": "A GitHub fine-grained token." },
    { "id": "secret-gitlab-token", "source": "(?<![A-Za-z0-9])glpat-[A-Za-z0-9_-]{20,}", "flags": "", "target": "decoded", "description": "A GitLab token." },
    { "id": "secret-anthropic-key", "source": "(?<![A-Za-z0-9])sk-ant-[A-Za-z0-9_-]{20,}", "flags": "", "target": "decoded", "description": "An Anthropic API key." },
    { "id": "secret-openai-key", "source": "(?<![A-Za-z0-9])sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{32,}", "flags": "", "target": "decoded", "description": "An OpenAI API key." },
    { "id": "secret-aws-access-key", "source": "(?<![A-Za-z0-9])(?:AKIA|ASIA)[0-9A-Z]{16}(?![0-9A-Z])", "flags": "", "target": "decoded", "description": "An AWS access key id." },
    { "id": "secret-google-api-key", "source": "(?<![A-Za-z0-9])AIza[0-9A-Za-z_-]{35}", "flags": "", "target": "decoded", "description": "A Google API key." },
    { "id": "secret-google-oauth", "source": "(?<![A-Za-z0-9])ya29\\.[0-9A-Za-z_-]{20,}", "flags": "", "target": "decoded", "description": "A Google OAuth access token." },
    { "id": "secret-slack-token", "source": "(?<![A-Za-z0-9])xox[abcdeoprs]-[A-Za-z0-9-]{10,}", "flags": "", "target": "decoded", "description": "A Slack token." },
    { "id": "secret-slack-app-token", "source": "(?<![A-Za-z0-9])xapp-[A-Za-z0-9-]{10,}", "flags": "", "target": "decoded", "description": "A Slack app token." },
    { "id": "secret-slack-webhook", "source": "hooks\\.slack\\.com/services/[A-Za-z0-9/_-]{20,}", "flags": "", "target": "decoded", "description": "A Slack incoming webhook URL." },
    { "id": "secret-atlassian-token", "source": "(?<![A-Za-z0-9])ATATT[A-Za-z0-9_=-]{20,}", "flags": "", "target": "decoded", "description": "An Atlassian API token." },
    { "id": "secret-stripe-key", "source": "(?<![A-Za-z0-9])[rs]k_live_[0-9A-Za-z]{20,}", "flags": "", "target": "decoded", "description": "A Stripe live key." },
    { "id": "secret-npm-token", "source": "(?<![A-Za-z0-9])npm_[A-Za-z0-9]{36}", "flags": "", "target": "decoded", "description": "An npm token." },
    { "id": "secret-huggingface-token", "source": "(?<![A-Za-z0-9])hf_[A-Za-z0-9]{30,}", "flags": "", "target": "decoded", "description": "A Hugging Face token." },
    { "id": "secret-sendgrid-key", "source": "(?<![A-Za-z0-9])SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}", "flags": "", "target": "decoded", "description": "A SendGrid key." },
    { "id": "secret-mailgun-key", "source": "(?<![A-Za-z0-9])key-[0-9a-f]{32}(?![0-9a-f])", "flags": "", "target": "decoded", "description": "A Mailgun key." },
    { "id": "secret-jwt", "source": "(?<![A-Za-z0-9])eyJ[A-Za-z0-9_-]{8,}\\.eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}", "flags": "", "target": "decoded", "description": "A JSON Web Token." },
    { "id": "secret-bearer", "source": "(?<![A-Za-z0-9])[Bb]earer\\s+[A-Za-z0-9._~+/-]{20,}=*", "flags": "", "target": "decoded", "description": "A bearer credential." },
    { "id": "secret-basic-auth", "source": "(?<![A-Za-z0-9])[Bb]asic\\s+([A-Za-z0-9+/]{8,}={0,2})", "flags": "", "target": "decoded", "confirm": "basic-credentials", "description": "A Basic credential that decodes to user:password." },
    { "id": "secret-url-credentials", "source": "(?<![A-Za-z0-9+.-])[A-Za-z][A-Za-z0-9+.-]{0,31}://[^\\s/:@\"'\\\\]{0,256}:([^\\s/@\"'\\\\]{1,256})@", "flags": "", "target": "decoded", "confirm": "url-password", "description": "A URL carrying a password (a masked or placeholder one is not)." },
    { "id": "secret-high-entropy", "source": "(?<![A-Za-z0-9+/=_-])[A-Za-z0-9+/=_-]{24,}(?![A-Za-z0-9+/=_-])", "flags": "", "target": "split", "confirm": "looks-random", "description": "A long random-looking run (mixed case and digits, no seven-letter lower-case word, at least 3.5 bits per character); SRI digests are digests, an inner = splits an assignment, a slash-separated run of words or upper-case names is a path, and a run of capitalised words, acronyms and numbers is an identifier." }
  ],
  "exceptions": [
    { "string": "Run and funded by Corefinity", "description": "The sponsor credit, plain." },
    { "string": "Run and funded by [Corefinity](https://corefinity.com)", "description": "The sponsor credit in Markdown." },
    { "string": "Run and funded by <a href=\"https://corefinit\u0079.com\">Corefinit\u0079</a>", "description": "The sponsor credit in HTML (escaped here so the raw line holds no other match)." },
    { "string": "https://corefinity.com", "description": "The sponsor credit's link." },
    { "string": "github.com/navidnadali/t3code", "description": "The fork URL (with or without https://)." },
    { "string": "Co-Authored-By: Claude Opus 5.5 <noreply\u0040anthropic.com>", "scope": "messages", "description": "The permitted co-author trailer, in commit messages only (escaped here so this file passes its own scan)." },
    { "string": "\"https://plausible.io/js/pa-Azz1Gvoc\u0072wyJk70JclINr.js\"", "path": "site/config.json", "description": "The site's analytics script URL, a public value the browser loads, as the exact quoted value in site/config.json only (escaped here so this file passes its own scan)." },
    { "string": "\"NODE_OPTIONS=--max-old-space-si\u007ae=8192\"", "path": "tools/t3cp/run-record.sh", "description": "Chosen bench parameter (8192 MiB): the exact quoted value in the runner and the test that pins it only (escaped here so this file passes its own scan)." },
    { "string": "\"NODE_OPTIONS=--max-old-space-si\u007ae=8192\"", "path": "tools/t3cp/runner/run-record.test.mjs", "description": "Chosen bench parameter (8192 MiB): the exact quoted value in the runner and the test that pins it only (escaped here so this file passes its own scan)." }
  ],
  "refusals": {
    "max_bytes": 1000000,
    "extensions": [".sqlite", ".sqlite3", ".sqlite-wal", ".sqlite-shm", ".db", ".db-wal", ".db-shm", ".ndjson", ".log", ".cpuprofile", ".heapsnapshot", ".heapprofile"],
    "path_components": { "creds": "path-creds", "plans": "path-plans" },
    "bench_settings": "settings.json"
  },
  "binary_allow": []
}
